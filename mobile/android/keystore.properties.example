# Android release signing configuration.
# Copy this file to keystore.properties (gitignored) and fill in real values.
#
# Alternatively, set the equivalent environment variables:
#   FINDMYSTAR_UPLOAD_STORE_FILE
#   FINDMYSTAR_UPLOAD_STORE_PASSWORD
#   FINDMYSTAR_UPLOAD_KEY_ALIAS
#   FINDMYSTAR_UPLOAD_KEY_PASSWORD
#
# To generate a new upload keystore:
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore release.keystore -alias findmystar \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=release.keystore
storePassword=
keyAlias=findmystar
keyPassword=
