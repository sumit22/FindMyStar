{
  "name": "findmystar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:e2e:android": "detox test -c android.emu.debug",
    "test:e2e:ios": "detox test -c ios.sim.debug",
    "test:e2e:build:android": "detox build -c android.emu.debug",
    "test:e2e:build:ios": "detox build -c ios.sim.debug",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "react": "19.0.0",
    "react-native": "0.78.2",
    "react-native-reanimated": "^3.16.0",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.18.0",
    "react-native-sqlite-storage": "^6.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "^18.0.0",
    "@react-native-community/cli-platform-android": "^18.0.0",
    "@react-native-community/cli-platform-ios": "^18.0.0",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/eslint-config": "0.78.2",
    "@react-native/metro-config": "0.78.2",
    "@react-native/typescript-config": "0.78.2",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^18.3.0",
    "detox": "^20.27.0",
    "detox-cli": "^20.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.0",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.7.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
