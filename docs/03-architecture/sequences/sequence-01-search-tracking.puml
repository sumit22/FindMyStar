@startuml
actor User
participant "SearchScreen" as UI
participant "CatalogRepository" as DB
participant "TrackingController" as Controller
participant "TrackingService" as Tracking

User -> UI: enterSearchQuery("Saturn")
UI -> DB: findByName("Saturn")
DB --> UI: CelestialObject {id, name, ra, dec, ...}

User -> UI: tap "Track"
UI -> Controller: startTracking(object)
Controller -> Tracking: initialize(object)
Tracking --> Controller: trackingStarted
Controller -> UI: navigateToARScreen()

@enduml
